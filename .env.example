# --- Qdrant ---
QDRANT_URL=http://localhost:6333
# Required for Qdrant Cloud, leave empty for local Docker
QDRANT_API_KEY=
# Collection to read and write. Separate values give one Qdrant instance
# independent staging and production indexes.
QDRANT_COLLECTION=docs

# --- OpenAI ---
OPENAI_API_KEY=

# --- Ingestion ---
# Absolute path to the corpus root. Every ingest request must resolve inside
# it; anything outside is rejected. Defaults to the process working directory,
# which is rarely what you want on a server.
INGEST_ROOT=

# --- Retrieval ---
# Results returned per query when the caller does not specify.
DEFAULT_TOP_K=3
DEFAULT_SCORE_THRESHOLD=0
